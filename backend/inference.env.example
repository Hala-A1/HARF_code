# Connections are environment-owned. Model policy is managed by the super admin.
INFERENCE_CONNECTION_SOURCE=environment
# Unset MODEL_PROVIDER preserves the previous Azure adapter during rollout.
# live enables both gateways; mock blocks all live inference.
MODEL_PROVIDER=live
DEFAULT_MAX_TOKENS=4096
DEFAULT_TEMPERATURE=0.7

# Cloud gateway: Responses API. Base stops before /responses.
APIM_BASE_URL=https://your-resource.openai.azure.com/openai
APIM_API_VERSION=2025-04-01-preview
APIM_API_STYLE=azure
APIM_API_TYPE=responses
APIM_AUTH_HEADER=api-key
APIM_API_KEY=
# Omit/[] to allow the super admin to manage cloud model IDs.
AZURE_EXPLICIT_DEPLOYMENTS=[]

# Internal gateway: Chat Completions. Do not append /v1 unless required by IT.
LITELLM_BASE_URL=https://your-internal-gateway.example
LITELLM_API_KEY=
LITELLM_API_TYPE=chat_completions
ON_PREM_EXPLICIT_MODELS=["llama4-scout","gpt-oss-120b","Qwen3-Coder-Next"]
TIMEOUT_SECONDS=120

# Optional shared env file for live model-list/default-output edits.
# It may contain AZURE_EXPLICIT_DEPLOYMENTS, ON_PREM_EXPLICIT_MODELS and
# DEFAULT_MAX_TOKENS. New catalog reads merge changes with saved admin overrides.
# Normal process environment/code edits require the usual backend reload.
# INFERENCE_CATALOG_ENV_FILE=C:/deployment/model-catalog.env
