# Local Oracle connection and runtime storage selection.
# Copy the required settings into the project root .env (ignored by Git).
# Administration tools can prompt locally. The running server needs the password
# in this ignored file or an IT-managed environment/secret provider.
REWRITE_STORAGE_BACKEND=local
ORACLE_USER=REWRITE_APP
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_PASSWORD=
# AIDEV: replace the DSN with IT's approved host, port and service; never use SYSTEM.
# Only enable Oracle after schema 003, import and verification. The wizard does
# this in order. Restart the backend after changing storage selection.
