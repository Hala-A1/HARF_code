# Add these settings to the repository-root .env, which the backend loads.
DOCLING_ENABLED=true
DOCLING_BASE_URL=https://your-docling-service.example
DOCLING_TRUST_ENV=true
DOCLING_DO_OCR=true
DOCLING_POLL_MAX_TIME_S=180
# DOCLING_API_KEY=configure-securely-if-required

# Scanned/mixed PDFs use the existing Azure AI image-reading deployment.
# Readable PDFs and DOCX continue through Docling. OCR never rewrites the text.
SCAN_OCR_FALLBACK_ENABLED=true
# Limits apply to scanned pages, not native text pages. No partial result is accepted.
SCAN_OCR_MAX_PAGES=50
SCAN_OCR_TIMEOUT_S=900
# Optional: only enable after confirming the service has these OCR languages
# and the named engine installed. Omission retains the service defaults.
# DOCLING_OCR_LANGUAGES=ar,en
# DOCLING_OCR_PRESET=easyocr
# Shared document deadline. Up to two pages are read concurrently; rendering
# remains serialized and all AI calls retain the channel's request limits.
# Deployments should allow the upload response to run for this processing time.
# The existing COPYWRITER_AZURE_OPENAI_* (or AZURE_OPENAI_*) settings must point
# to a deployment that supports image input. No separate OCR credentials needed.
