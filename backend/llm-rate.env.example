# Default maximum outbound LLM attempts in any rolling 60 seconds.
LLM_REQUESTS_PER_MINUTE=50
# Default cap for a channel without an explicit override.
LLM_CHANNEL_REQUESTS_PER_MINUTE=50
# Super-admin changes maintain this channel-to-limit mapping.
LLM_CHANNEL_RATE_LIMITS={}
# Maximum queue wait per attempt; up to eight calls wait per worker process.
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=120
