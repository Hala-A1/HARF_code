# Copy into your deployment environment or root .env after IT provides settings.
# AUTH_MODE=ldap fails closed: local passwords/email-only headers are not accepted.
AUTH_MODE=local
LDAP_HOST=
LDAP_PORT=636
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(mail={email})
LDAP_ID_ATTRIBUTE=objectGUID
LDAP_CA_CERT_FILE=
# Generate a random secret of at least 32 characters; never commit its value.
LDAP_SESSION_SECRET=
