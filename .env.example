# Copy to .env locally and configure approved service settings.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT
AZURE_OPENAI_MODEL=gpt-5.1
DOCLING_ENABLED=false
DOCLING_BASE_URL=
DOCLING_TRUST_ENV=true
DOCLING_DO_OCR=true
DOCLING_POLL_MAX_TIME_S=180
SCAN_OCR_FALLBACK_ENABLED=true
SCAN_OCR_MAX_PAGES=50
SCAN_OCR_TIMEOUT_S=300

# AI traffic caps; super-admin edits are persisted in backend/llm-rate.local.env.
LLM_REQUESTS_PER_MINUTE=50
LLM_CHANNEL_REQUESTS_PER_MINUTE=50
LLM_CHANNEL_RATE_LIMITS={}
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=120

# Additional inference.env settings (configure in root .env)
INFERENCE_CONNECTION_SOURCE=environment
MODEL_PROVIDER=live
DEFAULT_MAX_TOKENS=4096
DEFAULT_TEMPERATURE=0.7
APIM_BASE_URL=https://your-resource.openai.azure.com/openai
APIM_API_VERSION=2025-04-01-preview
APIM_API_STYLE=azure
APIM_API_TYPE=responses
APIM_AUTH_HEADER=api-key
APIM_API_KEY=
AZURE_EXPLICIT_DEPLOYMENTS=[]
LITELLM_BASE_URL=https://your-internal-gateway.example
LITELLM_API_KEY=
LITELLM_API_TYPE=chat_completions
ON_PREM_EXPLICIT_MODELS=["llama4-scout","gpt-oss-120b","Qwen3-Coder-Next"]
TIMEOUT_SECONDS=120

# Additional ldap.env settings (configure in root .env)
AUTH_MODE=local
# Production directory sign-in (developer backup requires explicit developer mode).
# AUTH_PROVIDER=ldap
# DEVELOPER_MODE=false
LDAP_SUPER_ADMIN_USERNAMES=bmahrouseh,selkhiat,mohmay,haamir
LDAP_HOST=
LDAP_PORT=636
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(mail={email})
LDAP_ID_ATTRIBUTE=objectGUID
LDAP_CA_CERT_FILE=
LDAP_SESSION_SECRET=

# Additional oracle.env settings (configure in root .env)
REWRITE_STORAGE_BACKEND=local
ORACLE_USER=REWRITE_APP
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_PASSWORD=

# Additional platform-policy.env settings (configure in root .env)
USER_LOG_RETENTION_DAYS=180
DEFAULT_MAX_INPUT_TOKENS=64000
LLM_MODEL_INPUT_TOKEN_LIMITS={}
